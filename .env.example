# Canonical origin — drives metadata, sitemap and the OG card
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Resend, for the /start forms. Without RESEND_API_KEY the forms fall back
# to opening the visitor's mail app with the answers filled in.
RESEND_API_KEY=
# Verified sender in Resend. Leave unset to use Resend's shared test sender,
# which only delivers to the address that owns the Resend account.
RESEND_FROM=Quarix <hello@your-domain.com>
# Where enquiries land. Defaults to the address in lib/site.ts.
RESEND_TO=
